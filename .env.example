# PassiveShield AI - Backend Environment Configuration Example
# Copy this file to .env before starting services with Docker Compose.

# Database Configuration (PostgreSQL / Primary Persistence)
POSTGRES_USER=passiveshield
POSTGRES_PASSWORD=passiveshield_dev_secret_change_in_prod
POSTGRES_DB=passiveshield_db
POSTGRES_PORT=5432

# State Store Configuration (Redis)
REDIS_PASSWORD=redis_dev_secret_change_in_prod
REDIS_PORT=6379

# Streaming Bus Configuration (Redpanda)
REDPANDA_KAFKA_PORT=9092
REDPANDA_PANDAPROXY_PORT=8082
REDPANDA_SCHEMA_REGISTRY_PORT=8081
REDPANDA_CONSOLE_PORT=8080

# Backend Service Configuration
API_PORT=3000
SOCKET_PORT=3001
NODE_ENV=development
